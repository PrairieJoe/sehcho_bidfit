# Supabase server-only configuration. Never expose the service key to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_ACCESS_CODE=

# Vercel Cron signature secret
CRON_SECRET=

# 나라장터 OpenAPI service key (server-only)
NARAJANGTEO_SERVICE_KEY=

# Gemini text-only attachment analysis (server-only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# If the 72-hour service count exceeds this value, the batch re-queries only the latest 24 hours.
GEMINI_DAILY_NOTICE_LIMIT=100
